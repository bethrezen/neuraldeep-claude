# Copy to .env. This is the only place for NeuralDeep credentials.
NEURALDEEP_API_KEY_SUBSCRIPTION=
NEURALDEEP_API_KEY_WALLET=
# Optional, separate Drift token (not a Hub API key):
NEURALDEEP_DRIFT_TOKEN=
# Optional USD/RUB override for Desktop cost estimates. If empty, official CBR
# data is fetched directly and cached with its source/date (billing stays RUB).
NEURALDEEP_USD_RUB_RATE=
